... ; ================================================================
==> (2 1)

>>> (define-syntax my-case
...   (syntax-rules (=>)
...     ((my-case val (test => result))
...      (if (equal? val test) result 'no-match))))
==> #<void>

>>> (my-case 2 (2 => 'found))
==> found

>>> (my-case 5 (2 => 'found))
