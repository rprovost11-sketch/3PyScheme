>>> (let ((tmp 1) (x 2))
...   (swap! tmp x)
...   (list tmp x))
... ; --- my-or: template 't' must not capture user's 't' ---
==> (1 2)

>>> (define-syntax my-or
...   (syntax-rules ()
...     ((my-or a b)
...      (let ((t a)) (if t t b)))))
==> #<void>

>>> (let ((t 5))
...   (my-or #f t))
... ; --- my-and2: template 'v' must not capture user's 'v' ---
==> #f

>>> (define-syntax my-and2
...   (syntax-rules ()
...     ((my-and2 a b)
...      (let ((v a)) (if v b #f)))))
==> #<void>

>>> (let ((v 10))
...   (my-and2 #t v))
... ; ================================================================
... ; 15. BOUND IDENTIFIERS STILL WORK (inc2 uses +)
... ; ================================================================
==> #t

>>> (define-syntax inc2
...   (syntax-rules ()
...     ((inc2 x) (+ x 1))))
==> #<void>

>>> (inc2 41)
... ; definition-time binding used even when call site shadows +
==> 42

>>> (let ((+ *)) (inc2 5))
... ; shadowed * in let-syntax — macro uses definition-time *
==> 6

>>> (let-syntax ((double (syntax-rules ()
...               ((double x) (* x 2)))))
...   (let ((* +)) (double 7)))
... ; letrec-syntax uses definition-time + despite shadowing
==> 14

>>> (let ((+ *))
...   (letrec-syntax
...     ((foo (syntax-rules () ((foo x) (bar x x))))
...      (bar (syntax-rules () ((bar x y) (+ x y)))))
...     (foo 5)))
... ; nested macros preserve definition-time bindings
%%% unbound variable: foo

