>>> (define-syntax my-if
...   (syntax-rules ()
...     ((my-if test then else)
...      (cond (test then) (else else)))))
==> #<void>

>>> (my-if #t 'yes 'no)
==> yes

>>> (my-if #f 'yes 'no)
... ; ================================================================
... ; 2. SWAP! MACRO
... ; ================================================================
==> no

>>> (define-syntax swap!
...   (syntax-rules ()
...     ((swap! a b)
...      (let ((tmp a))
...        (set! a b)
...        (set! b tmp)))))
==> #<void>

>>> (define x 1)
==> #<void>

>>> (define y 2)
==> #<void>

>>> (swap! x y)
==> #<void>

>>> y
... ; ================================================================
... ; 3. WHILE LOOP MACRO (ellipsis in body)
... ; ================================================================
==> 1

>>> (define-syntax while
...   (syntax-rules ()
...     ((while test body ...)
...      (let loop ()
...        (if test
...            (begin body ... (loop)))))))
==> #<void>

>>> (define i 0)
==> #<void>

>>> (define sum 0)
==> #<void>

>>> (while (< i 5)
...   (set! sum (+ sum i))
...   (set! i (+ i 1)))
==> #<void>

>>> sum
... ; ================================================================
... ; 4. MY-AND, MY-OR MACROS (ellipsis patterns)
... ; ================================================================
... ; --- my-and ---
==> 10

>>> (define-syntax my-and
...   (syntax-rules ()
...     ((my-and)
...      #t)
...     ((my-and e)
...      e)
...     ((my-and e1 e2 ...)
...      (if e1 (my-and e2 ...) #f))))
==> #<void>

>>> (my-and)
==> #t

>>> (my-and 1)
==> 1

>>> (my-and 1 2 3)
==> 3

>>> (my-and 1 #f 3)
... ; --- my-or ---
==> #f

>>> (define-syntax my-or
...   (syntax-rules ()
...     ((my-or)
...      #f)
...     ((my-or e)
...      e)
...     ((my-or e1 e2 ...)
...      (let ((t e1))
...        (if t t (my-or e2 ...))))))
==> #<void>

>>> (my-or)
==> #f

>>> (my-or #f #f #f)
... ; ================================================================
... ; 5. PUSH! MACRO
... ; ================================================================
==> #f

>>> (define-syntax push!
...   (syntax-rules ()
...     ((push! val lst)
...      (set! lst (cons val lst)))))
==> #<void>

>>> (define stack '())
==> #<void>

>>> (push! 1 stack)
==> #<void>

>>> (push! 2 stack)
==> #<void>

>>> stack
