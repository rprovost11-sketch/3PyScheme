>>> (define-syntax my-list-of-lists
...   (syntax-rules ()
...     ((my-list-of-lists (x ...) ...)
...      (list (list x ...) ...))))
==> #<void>

>>> (my-list-of-lists (1 2 3) (4 5))
... ; --- labeled-rows: nested ellipsis with mixed depth vars ---
==> ((1 2 3) (4 5))

>>> (define-syntax labeled-rows
...   (syntax-rules ()
...     ((labeled-rows (label val ...) ...)
...      (list (cons 'label (list val ...)) ...))))
==> #<void>

>>> (labeled-rows (a 1 2) (b 3 4 5))
... ; --- zero-length nested ellipsis ---
==> ((a 1 2) (b 3 4 5))

>>> (my-list-of-lists)
... ; --- single-row nested ellipsis ---
==> ()

>>> (my-list-of-lists (10 20 30))
... ; --- depth-3 nested ellipsis ---
==> ((10 20 30))

