;;; ============================================================
;;; test19-library.log
;;; R7RS-small library compliance additions:
;;;   char-foldcase, char-ci comparisons,
;;;   string-foldcase, string-ci comparisons,
;;;   member/assoc with optional compare procedure,
;;;   write-shared, write-simple,
;;;   file-exists?, delete-file, rename-file,
;;;   call-with-input-file, call-with-output-file,
;;;   with-input-from-file, with-output-to-file,
;;;   load, get-environment-variable, get-environment-variables,
;;;   current-second, current-jiffy, jiffies-per-second,
;;;   null-environment, scheme-report-environment.
;;; ============================================================

;;; -------- char-foldcase --------

>>> (char-foldcase #\A)
==> #\a

>>> (char-foldcase #\Z)
==> #\z

>>> (char-foldcase #\newline)
==> #\newline

;;; -------- char-ci comparisons --------

>>> (char-ci=? #\A #\a)
==> #t

>>> (char-ci=? #\A #\b)
==> #f

>>> (char-ci<? #\A #\B)
==> #t

>>> (char-ci<? #\B #\A)
==> #f

>>> (char-ci<=? #\A #\A)
==> #t

>>> (char-ci>? #\B #\a)
==> #t

>>> (char-ci>=? #\Z #\a)
==> #t

>>> (char-ci>=? #\A #\z)
==> #f

;;; multi-argument char-ci

>>> (char-ci=? #\A #\a #\A)
==> #t

>>> (char-ci<? #\A #\B #\C)
==> #t

;;; -------- string-foldcase --------

>>> (string-foldcase "Hello")
==> "hello"

>>> (string-foldcase "WORLD")
==> "world"

>>> (string-foldcase "already")
==> "already"

;;; -------- string-ci comparisons --------

>>> (string-ci=? "Hello" "hello")
==> #t

>>> (string-ci=? "Hello" "HELLO")
==> #t

>>> (string-ci=? "abc" "xyz")
==> #f

>>> (string-ci<? "abc" "XYZ")
==> #t

>>> (string-ci<? "xyz" "abc")
==> #f

>>> (string-ci<=? "abc" "ABC")
==> #t

>>> (string-ci>? "XYZ" "abc")
==> #t

>>> (string-ci>=? "ABC" "abc")
==> #t

;;; multi-argument string-ci

>>> (string-ci<? "abc" "ABD" "xyz")
==> #t

;;; -------- member with optional compare --------

>>> (member 2.0 (list 1 2 3) =)
==> (2 3)

>>> (member 2.0 (list 1 2 3) eqv?)
==> #f

>>> (member "b" (list "a" "b" "c") string=?)
==> ("b" "c")

>>> (member "B" (list "a" "b" "c") string-ci=?)
==> ("b" "c")

;;; -------- assoc with optional compare --------

>>> (assoc 2.0 (list (list 1 "a") (list 2 "b") (list 3 "c")) =)
==> (2 "b")

>>> (assoc "B" (list (list "a" 1) (list "b" 2)) string-ci=?)
==> ("b" 2)

;;; -------- write-shared and write-simple --------

>>> (let ((p (open-output-string))) (write-shared (list 1 2 3) p) (get-output-string p))
==> "(1 2 3)"

>>> (let ((p (open-output-string))) (write-simple "hello" p) (get-output-string p))
==> "\"hello\""

;;; -------- file-exists? --------

>>> (file-exists? "testing/test00-parser.log")
==> #t

>>> (file-exists? "no-such-file-xyz.scm")
==> #f

;;; -------- call-with-input-file --------

>>> (call-with-output-file "testing/test19-tmp.scm" (lambda (p) (write (quote (+ 1 2)) p) #t))
==> #t

>>> (call-with-input-file "testing/test19-tmp.scm" read)
==> (+ 1 2)

;;; -------- with-input-from-file --------

>>> (with-input-from-file "testing/test19-tmp.scm" read)
==> (+ 1 2)

;;; -------- with-output-to-file --------

>>> (with-output-to-file "testing/test19-tmp2.txt" (lambda () (display "ok")))
==> #<void>

>>> (file-exists? "testing/test19-tmp2.txt")
==> #t

;;; -------- delete-file and rename-file --------

>>> (delete-file "testing/test19-tmp2.txt")
==> #<void>

>>> (file-exists? "testing/test19-tmp2.txt")
==> #f

>>> (rename-file "testing/test19-tmp.scm" "testing/test19-tmp-renamed.scm")
==> #<void>

>>> (file-exists? "testing/test19-tmp.scm")
==> #f

>>> (file-exists? "testing/test19-tmp-renamed.scm")
==> #t

>>> (delete-file "testing/test19-tmp-renamed.scm")
==> #<void>

;;; -------- load --------

>>> (call-with-output-file "testing/test19-load.scm" (lambda (p) (write (quote (define load-test-result 42)) p) #t))
==> #t

>>> (load "testing/test19-load.scm")
==> #<void>

>>> load-test-result
==> 42

>>> (delete-file "testing/test19-load.scm")
==> #<void>

;;; -------- get-environment-variable --------

>>> (string? (get-environment-variable "PATH"))
==> #t

>>> (boolean? (get-environment-variable "NONEXISTENT_VAR_XYZ_999"))
==> #t

>>> (get-environment-variable "NONEXISTENT_VAR_XYZ_999")
==> #f

;;; -------- get-environment-variables --------

>>> (pair? (get-environment-variables))
==> #t

>>> (pair? (car (get-environment-variables)))
==> #t

;;; -------- time procedures --------

>>> (jiffies-per-second)
==> 1000

>>> (integer? (current-jiffy))
==> #t

>>> (real? (current-second))
==> #t

>>> (positive? (current-second))
==> #t

;;; -------- null-environment and scheme-report-environment --------

>>> (procedure? (eval (quote car) (scheme-report-environment 5)))
==> #t

>>> (eval (quote (+ 1 2)) (scheme-report-environment 5))
==> 3

>>> (eval (quote (+ 1 2)) (null-environment 5))
%%% line 1, col 15: unbound variable: +
%%% (eval (quote (+ 1 2)) (null-environment 5))
%%%               ^
