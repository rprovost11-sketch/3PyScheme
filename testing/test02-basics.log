;;; ============================================================
;;; test02-basics.log
;;; Core evaluator: variable binding (define), mutation (set!),
;;; conditional (if), fixed-arity lambdas, arity errors, and
;;; multi-line input.  No primitives needed for any of these
;;; tests - only the core CEK machinery.
;;; ============================================================

;;; -------- define and variable reference --------

>>> (define a 5)
==> #<void>

>>> a
==> 5

>>> (define b 99)
==> #<void>

>>> b
==> 99

;;; -------- set! --------

>>> (set! a 100)
==> #<void>

>>> a
==> 100

>>> (set! undefined-var 1)
%%% line 1, col 7: set! on unbound variable: undefined-var
%%% (set! undefined-var 1)
%%%       ^

>>> unbound-ref
%%% line 1, col 1: unbound variable: unbound-ref
%%% unbound-ref
%%% ^

;;; -------- if --------

>>> (if #t 1 2)
==> 1

>>> (if #f 1 2)
==> 2

>>> (if #t 1)
==> 1

>>> (if #f 1)
==> #<void>

;;; In Scheme, only #f is false.  0 and '() and "" are all true.
>>> (if 0 'true 'false-branch)
==> true

;;; -------- Single-arg lambda + application --------

>>> ((lambda (x) x) 7)
==> 7

>>> (((lambda (x) (lambda (y) x)) 3) 9)
==> 3

>>> ((lambda (f) (f 3)) (lambda (x) x))
==> 3

;;; -------- define shorthand --------

>>> (define (id x) x)
==> #<void>

>>> (id 42)
==> 42

>>> (define id2 (lambda (x) x))
==> #<void>

>>> (id2 99)
==> 99

;;; -------- Multi-arg lambda --------

>>> ((lambda (x y) x) 11 22)
==> 11

>>> ((lambda (x y) y) 11 22)
==> 22

>>> ((lambda (a b c) b) 10 20 30)
==> 20

>>> ((lambda () 42))
==> 42

>>> (define (pick-second a b) b)
==> #<void>

>>> (pick-second 1 2)
==> 2

>>> (define (third a b c) c)
==> #<void>

>>> (third 100 200 300)
==> 300

;;; -------- Multi-expression body (implicit begin) --------

>>> ((lambda (x) (set! x 1) (set! x 2) x) 0)
==> 2

;;; -------- set! reaches up the lexical chain --------

>>> (define outer-x 1)
==> #<void>

>>> ((lambda (_) (set! outer-x 99)) 0)
==> #<void>

>>> outer-x
==> 99

;;; -------- Arity errors --------

>>> ((lambda (x y) x) 1)
%%% SchemeArityError: line 1, col 1: 1 argument provided; 2 expected
%%% ((lambda (x y) x) 1)
%%% ^

>>> ((lambda (x) x) 1 2)
%%% SchemeArityError: line 1, col 1: 2 arguments provided; 1 expected
%%% ((lambda (x) x) 1 2)
%%% ^

>>> ((lambda () 1) 99)
%%% SchemeArityError: line 1, col 1: 1 argument provided; 0 expected
%%% ((lambda () 1) 99)
%%% ^

;;; -------- Multi-line expressions --------

>>> (define square
...   (lambda (x)
...     ((lambda (n) n)
...      x)))
==> #<void>

>>> (square 7)
==> 7
