;;; ============================================================
;;; test06-quote-lists.log
;;; Quote syntax, cons-cell runtime values, and the basic list
;;; primitives (cons, car, cdr, pair?, null?, list).  Also exercises
;;; primitives-as-values (car bound in the environment, passed as an
;;; argument) and type/arity errors raised from primitive bodies.
;;; ============================================================

;;; -------- quote + cons cells --------

>>> 'foo
==> foo

>>> '()
==> ()

>>> '(1 2 3)
==> (1 2 3)

>>> '(a (b c) d)
==> (a (b c) d)

>>> (quote x)
==> x

>>> (quote ())
==> ()

>>> (quote (1 2 3))
==> (1 2 3)

;;; -------- list primitives --------

>>> (cons 1 2)
==> (1 . 2)

>>> (cons 1 '())
==> (1)

>>> (cons 1 (cons 2 (cons 3 '())))
==> (1 2 3)

>>> (car '(1 2 3))
==> 1

>>> (cdr '(1 2 3))
==> (2 3)

>>> (car (cons 'a 'b))
==> a

>>> (cdr (cons 'a 'b))
==> b

>>> (list)
==> ()

>>> (list 1 2 3)
==> (1 2 3)

>>> (list 'a 'b 'c)
==> (a b c)

>>> (pair? '(1))
==> #t

>>> (pair? '())
==> #f

>>> (pair? 1)
==> #f

>>> (null? '())
==> #t

>>> (null? '(1))
==> #f

>>> (null? 1)
==> #f

;;; -------- primitive is callable; appears as a value --------

>>> car
==> #<primitive car>

>>> ((lambda (f) (f '(1 2))) car)
==> 1

;;; -------- primitive type and arity errors --------

>>> (car '())
%%% SchemeTypeError: line 1, col 1: car: expected pair, got non-pair value
%%% (car '())
%%% ^

>>> (car 1)
%%% SchemeTypeError: line 1, col 1: car: expected pair, got non-pair value
%%% (car 1)
%%% ^

>>> (cdr '())
%%% SchemeTypeError: line 1, col 1: cdr: expected pair, got non-pair value
%%% (cdr '())
%%% ^

>>> (cons 1)
%%% SchemeArityError: line 1, col 1: cons: 1 argument provided; 2 expected
%%% (cons 1)
%%% ^

>>> (car 1 2)
%%% SchemeArityError: line 1, col 1: car: 2 arguments provided; 1 expected
%%% (car 1 2)
%%% ^
