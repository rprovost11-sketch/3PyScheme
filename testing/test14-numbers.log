;;; ============================================================
;;; test14-numbers.log
;;; R7RS §6.2 numeric tower Phase 1:
;;;   +inf.0 / -inf.0 / +nan.0 literals
;;;   finite? / infinite? / nan?
;;;   transcendentals: exp, log, sin, cos, tan, asin, acos, atan
;;;   string->number for special reals
;;;   floor/ceiling/truncate/round on inf/nan
;;;   / by inexact zero
;;; ============================================================

;;; -------- special real literals --------

>>> +inf.0
==> +inf.0

>>> -inf.0
==> -inf.0

>>> +nan.0
==> +nan.0

;;; -------- arithmetic on special reals --------

>>> (+ +inf.0 1)
==> +inf.0

>>> (+ +inf.0 +inf.0)
==> +inf.0

>>> (- +inf.0 +inf.0)
==> +nan.0

>>> (* 0 +inf.0)
==> +nan.0

>>> (* 2 +inf.0)
==> +inf.0

>>> (/ +inf.0 2)
==> +inf.0

;;; -------- / by inexact zero --------

>>> (/ 1 0.0)
==> +inf.0

>>> (/ -1 0.0)
==> -inf.0

>>> (/ 0 0.0)
==> +nan.0

;;; / by exact zero is still an error.
>>> (/ 1 0)
%%% SchemeTypeError: line 1, col 1: /: division by zero
%%% (/ 1 0)
%%% ^

;;; -------- comparison on special reals --------

>>> (= +inf.0 +inf.0)
==> #t

>>> (< -inf.0 0 +inf.0)
==> #t

>>> (> +inf.0 1000000)
==> #t

>>> (< +nan.0 0)
==> #f

;;; -------- type predicates on special reals --------

>>> (number? +inf.0)
==> #t

>>> (real? +inf.0)
==> #t

>>> (rational? +inf.0)
==> #f

>>> (integer? +inf.0)
==> #f

;;; -------- finite? --------

>>> (finite? 42)
==> #t

>>> (finite? 1.5)
==> #t

>>> (finite? +inf.0)
==> #f

>>> (finite? -inf.0)
==> #f

>>> (finite? +nan.0)
==> #f

;;; -------- infinite? --------

>>> (infinite? +inf.0)
==> #t

>>> (infinite? -inf.0)
==> #t

>>> (infinite? 42)
==> #f

>>> (infinite? +nan.0)
==> #f

;;; -------- nan? --------

>>> (nan? +nan.0)
==> #t

>>> (nan? +inf.0)
==> #f

>>> (nan? 42)
==> #f

>>> (nan? 0.0)
==> #f

;;; -------- floor / ceiling / truncate / round on special reals --------

>>> (floor +inf.0)
==> +inf.0

>>> (floor -inf.0)
==> -inf.0

>>> (floor +nan.0)
==> +nan.0

>>> (ceiling +inf.0)
==> +inf.0

>>> (ceiling -inf.0)
==> -inf.0

>>> (truncate +inf.0)
==> +inf.0

>>> (truncate +nan.0)
==> +nan.0

>>> (round +inf.0)
==> +inf.0

;;; -------- exp --------

>>> (exp 0)
==> 1.0

>>> (exp 1)
==> 2.718281828459045

>>> (exp -1)
==> 0.36787944117144233

>>> (finite? (exp 1000))
==> #f

;;; -------- log --------

>>> (log 1)
==> 0.0

>>> (log 0)
==> -inf.0

>>> (log -1)
==> +nan.0

;;; two-argument log: log base w of z.
>>> (log 100 10)
==> 2.0

;;; -------- sin / cos / tan --------

>>> (sin 0)
==> 0.0

>>> (cos 0)
==> 1.0

>>> (tan 0)
==> 0.0

;;; sin(pi/2) = 1.0
>>> (sin (/ (* 4 (atan 1)) 2))
==> 1.0

;;; -------- asin / acos / atan --------

>>> (asin 0)
==> 0.0

>>> (acos 1)
==> 0.0

>>> (atan 0)
==> 0.0

;;; atan2: atan(1, 1) = pi/4
>>> (atan 1 1)
==> 0.7853981633974483

;;; domain error: asin/acos outside [-1, 1] -> +nan.0.
>>> (asin 2)
==> +nan.0

>>> (acos 2)
==> +nan.0

;;; -------- pi via atan --------

>>> (* 4 (atan 1))
==> 3.141592653589793

;;; -------- number->string for special reals --------

>>> (number->string +inf.0)
==> "+inf.0"

>>> (number->string -inf.0)
==> "-inf.0"

>>> (number->string +nan.0)
==> "+nan.0"

;;; -------- string->number for special reals --------

>>> (string->number "+inf.0")
==> +inf.0

>>> (string->number "-inf.0")
==> -inf.0

>>> (string->number "+nan.0")
==> +nan.0

;;; string->number returns #f for unrecognised input.
>>> (string->number "not-a-number")
==> #f
