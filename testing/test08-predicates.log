;;; ============================================================
;;; test08-predicates.log
;;; Type predicates, numeric predicates, equivalence predicates,
;;; and the logical `not` primitive.
;;; ============================================================

;;; -------- Type predicates --------

>>> (number? 42)
==> #t

>>> (number? "hi")
==> #f

>>> (integer? 42)
==> #t

>>> (integer? '())
==> #f

>>> (boolean? #t)
==> #t

>>> (boolean? 0)
==> #f

>>> (symbol? 'x)
==> #t

>>> (symbol? "x")
==> #f

>>> (string? "hi")
==> #t

>>> (procedure? car)
==> #t

>>> (procedure? (lambda (x) x))
==> #t

>>> (procedure? 42)
==> #f

;;; -------- Numeric predicates --------

>>> (zero? 0)
==> #t

>>> (zero? 1)
==> #f

>>> (positive? 1)
==> #t

>>> (positive? 0)
==> #f

>>> (negative? -1)
==> #t

>>> (even? 4)
==> #t

>>> (odd? 3)
==> #t

;;; -------- Equivalence --------

>>> (eq? 'a 'a)
==> #t

>>> (eqv? 2 2)
==> #t

>>> (eqv? 2 2.0)
==> #f

>>> (equal? (list 1 2 3) (list 1 2 3))
==> #t

>>> (equal? '(1 (2 3)) '(1 (2 3)))
==> #t

>>> (equal? 42 "42")
==> #f

;;; -------- Logical --------

>>> (not #t)
==> #f

>>> (not #f)
==> #t

>>> (not 0)
==> #f

>>> (not '())
==> #f
