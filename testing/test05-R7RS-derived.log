;;; ============================================================
;;; test05-R7RS-derived.log
;;; R7RS section 4.2 derived forms: begin, when/unless, and/or,
;;; cond (all three clause forms including arrow), let / let* /
;;; letrec / letrec*, and named let.  Each form has its own
;;; dedicated EXPR_* / FRAME_* in the CEK machine.
;;; ============================================================

;;; -------- begin (R7RS 4.2.3 sequencing) --------

>>> (begin 1 2 3)
==> 3

>>> (begin 42)
==> 42

>>> (define counter 0)
==> #<void>

>>> (begin (set! counter 1) (set! counter 2) counter)
==> 2

;;; -------- when / unless (R7RS 4.2.1) --------

>>> (when #t 1 2 3)
==> 3

>>> (when #f 99)
==> #<void>

>>> (when 0 'truthy)
==> truthy

>>> (when (null? (list)) (cons 1 (list)))
==> (1)

>>> (unless #f 1 2 3)
==> 3

>>> (unless #t 99)
==> #<void>

>>> (unless (null? (list 1)) 'runs)
==> runs

;;; -------- and / or (R7RS 4.2.1) --------

>>> (and)
==> #t

>>> (and 1)
==> 1

>>> (and 1 2 3)
==> 3

>>> (and #f 99)
==> #f

>>> (and 1 #f 3)
==> #f

>>> (or)
==> #f

>>> (or 1)
==> 1

>>> (or #f #f 3)
==> 3

>>> (or #f #f #f)
==> #f

>>> (or 1 'would-not-evaluate)
==> 1

;;; -------- cond (R7RS 4.2.1) - all three clause forms --------

>>> (cond (#t 1))
==> 1

>>> (cond (#f 1) (#t 2) (else 3))
==> 2

>>> (cond (#f 1) (#f 2) (else 'fallback))
==> fallback

>>> (cond (#f 1))
==> #<void>

>>> (cond (42))
==> 42

>>> (cond (#f) (else 99))
==> 99

>>> (cond ((cons 1 2) => car))
==> 1

>>> (cond (#f => car) (else 'skipped))
==> skipped

>>> (cond ((cons 10 20) => cdr) (else 0))
==> 20

;;; -------- case (R7RS 4.2.1) - eqv?-based literal dispatch --------

>>> (case 2 ((1 2 3) 'small) ((4 5) 'med) (else 'big))
==> small

>>> (case 5 ((1 2 3) 'small) ((4 5) 'med) (else 'big))
==> med

>>> (case 99 ((1 2 3) 'small) ((4 5) 'med) (else 'big))
==> big

;;; Symbol datums are implicitly quoted.
>>> (case 'b ((a) 1) ((b c) 2) (else 3))
==> 2

;;; No match, no else - unspecified value.
>>> (case 99 ((1) 'one))
==> #<void>

;;; Multi-expression bodies (last value returned).
>>> (case 2 ((1 2) 'a 'b 'c) (else 'd))
==> c

;;; Single-datum singleton clause.
>>> (case 7 ((7) 'found) (else 'missing))
==> found

;;; Numeric exactness: eqv? distinguishes 2 and 2.0.
>>> (case 2 ((2.0) 'real) (else 'int))
==> int

>>> (case 2.0 ((2) 'int) (else 'real))
==> real

;;; Shape errors caught by the analyzer.
>>> (case)
%%% line 1, col 1: case requires a key and at least one clause
%%% (case)
%%% ^

>>> (case 1 (else 1) (else 2))
%%% line 1, col 9: case 'else' clause must be the last clause
%%% (case 1 (else 1) (else 2))
%%%         ^

>>> (case 1 (else 1) ((2) 'b))
%%% line 1, col 9: case 'else' clause must be the last clause
%%% (case 1 (else 1) ((2) 'b))
%%%         ^

>>> (case 1 ())
%%% line 1, col 9: case clause must be (<datum-list> <expr>...) or (else <expr>...), got ()
%%% (case 1 ())
%%%         ^

;;; -------- let (R7RS 4.2.2) --------

>>> (let ((x 1)) x)
==> 1

>>> (let () 42)
==> 42

>>> (let ((x 1) (y 2)) (cons x y))
==> (1 . 2)

>>> (let ((a 1) (b 2) (c 3)) (list a b c))
==> (1 2 3)

>>> (define outer 10)
==> #<void>

>>> (let ((outer 1)) outer)
==> 1

>>> outer
==> 10

;;; let binds vals in OUTER env - (y x) sees outer x, not the new x.
>>> (let ((x 99) (y outer)) (cons x y))
==> (99 . 10)

;;; -------- let* (R7RS 4.2.2) --------

>>> (let* ((x 1) (y x)) y)
==> 1

>>> (let* ((x 1) (y (cons x (list)))) y)
==> (1)

>>> (let* ((a 1) (b (cons a (list))) (c (cons 2 b))) c)
==> (2 1)

;;; -------- letrec / letrec* (R7RS 4.2.2) --------

>>> (letrec ((f (lambda (x) x))) (f 42))
==> 42

>>> (letrec ((last (lambda (lst) (if (null? (cdr lst)) (car lst) (last (cdr lst)))))) (last (list 1 2 3 4)))
==> 4

;;; Mutual recursion via letrec
>>> (letrec ((p? (lambda (lst) (if (null? lst) #t (q? (cdr lst))))) (q? (lambda (lst) (if (null? lst) #f (p? (cdr lst)))))) (p? (list 1 2 3 4)))
==> #t

>>> (letrec* ((f (lambda (x) x)) (g (lambda (x) (f x)))) (g 99))
==> 99

;;; -------- named let (R7RS 4.2.4) --------

>>> (let loop ((lst (list 1 2 3))) (if (null? lst) 'done (loop (cdr lst))))
==> done

>>> (let loop ((lst (list 1 2 3)) (acc (list))) (if (null? lst) acc (loop (cdr lst) (cons (car lst) acc))))
==> (3 2 1)

;;; -------- do (R7RS 4.2.4) - iteration --------

>>> (do ((i 0 (+ i 1))) ((= i 5) i))
==> 5

;;; Multiple bindings, single result expression.
>>> (do ((i 0 (+ i 1)) (s 0 (+ s i))) ((= i 5) s))
==> 10

;;; Empty result list - unspecified value.
>>> (do ((i 0 (+ i 1))) ((= i 3)))
==> #<void>

;;; Accumulator using cons; steps see current binding of i.
>>> (do ((i 0 (+ i 1)) (acc (list) (cons i acc))) ((= i 4) acc))
==> (3 2 1 0)

;;; Steps run in parallel (like let, not let*): both a and b see old values.
>>> (do ((a 1 b) (b 2 (+ a b))) ((> a 10) a))
==> 13

;;; A binding with no step: variable keeps its initial value.
>>> (do ((i 0 (+ i 1)) (v 'a)) ((= i 2) v))
==> a

;;; Zero-iteration case: test true immediately.
>>> (do ((x 'hi)) (#t x))
==> hi

;;; Multi-expression result (last value returned).
>>> (do ((i 0 (+ i 1))) ((= i 3) 'first 'second 'third))
==> third

;;; Shape errors caught by the analyzer.
>>> (do)
%%% line 1, col 1: do requires a binding list and a test clause
%%% (do)
%%% ^

>>> (do () ())
%%% line 1, col 8: do test clause must be a list starting with a test expression
%%% (do () ())
%%%        ^

>>> (do ((i)) ((= i 0) i))
%%% line 1, col 6: do binding must be (var init) or (var init step), got (i)
%%% (do ((i)) ((= i 0) i))
%%%      ^

>>> (do ((1 0)) ((= 1 0)))
%%% line 1, col 7: expected an identifier in do binding, got 1
%%% (do ((1 0)) ((= 1 0)))
%%%       ^

>>> (do ((i 0 (+ i 1)) (i 0)) ((= i 5) i))
%%% line 1, col 21: duplicate variable name in do bindings: i
%%% (do ((i 0 (+ i 1)) (i 0)) ((= i 5) i))
%%%                     ^

;;; -------- cond-expand (R7RS 5.6.2) - compile-time feature dispatch --------

>>> (cond-expand (r7rs 'yes-r7rs) (else 'no))
==> yes-r7rs

>>> (cond-expand (nosuch-feature 'no) (else 'fallback))
==> fallback

>>> (cond-expand ((and r7rs pyscheme) 'both) (else 'partial))
==> both

>>> (cond-expand ((or nosuch r7rs) 'matched) (else 'no))
==> matched

>>> (cond-expand ((not nosuch) 'yes) (else 'no))
==> yes

>>> (cond-expand ((library (srfi 1)) 'have-srfi) (else 'no-srfi))
==> no-srfi

;;; Definitions spliced at top level persist.
>>> (cond-expand (r7rs (define sq (lambda (x) (* x x)))) (else 'skip)) (sq 9)
==> 81

;;; Shape errors.
>>> (cond-expand)
%%% line 1, col 1: cond-expand requires at least one clause
%%% (cond-expand)
%%% ^

>>> (cond-expand (nosuch 1))
%%% line 1, col 1: cond-expand: no clause matched
%%% (cond-expand (nosuch 1))
%%% ^

;;; -------- case-lambda (R7RS 4.2.9) - arity-dispatched lambda --------

>>> (define f (case-lambda ((x) (list 'one x)) ((x y) (list 'two x y)) ((x y . rest) (list 'many x y rest)))) (f 1)
==> (one 1)

>>> (define f (case-lambda ((x) (list 'one x)) ((x y) (list 'two x y)) ((x y . rest) (list 'many x y rest)))) (f 10 20)
==> (two 10 20)

>>> (define f (case-lambda ((x) (list 'one x)) ((x y) (list 'two x y)) ((x y . rest) (list 'many x y rest)))) (f 1 2 3 4 5)
==> (many 1 2 (3 4 5))

;;; Nullary and unary clauses.
>>> (define g (case-lambda (() 'zero) ((a) a))) (g)
==> zero

>>> (define g (case-lambda (() 'zero) ((a) a))) (g 42)
==> 42

;;; case-lambda values are procedures.
>>> (procedure? (case-lambda ((x) x)))
==> #t

;;; apply dispatches through case-lambda too.
>>> (apply (case-lambda ((x) 'one) ((x y z) 'three)) '(1 2 3))
==> three

;;; No matching clause - runtime error.
>>> (define g (case-lambda (() 'zero) ((a) a))) (g 1 2 3)
%%% SchemeArityError: line 1, col 45: case-lambda: no clause matches 3 arguments
%%% (define g (case-lambda (() 'zero) ((a) a))) (g 1 2 3)
%%%                                             ^

;;; Shape errors.
>>> (case-lambda)
%%% line 1, col 1: case-lambda requires at least one clause
%%% (case-lambda)
%%% ^

>>> (case-lambda (() . body))
%%% line 1, col 14: case-lambda clause must have formals and a non-empty body, got (() . body)
%%% (case-lambda (() . body))
%%%              ^

;;; -------- quasiquote (R7RS 4.2.8) - template construction --------

;;; Bare quasiquote with no holes is the same as quote.
>>> `(a b c)
==> (a b c)

>>> `()
==> ()

>>> `42
==> 42

;;; Unquote with ,
>>> (define x 42) `(x is ,x)
==> (x is 42)

>>> `(,(+ 1 2) ,(* 3 4))
==> (3 12)

;;; Unquote-splicing with ,@
>>> `(a ,@(list 1 2 3) b)
==> (a 1 2 3 b)

>>> `(,@(list 1 2) ,@(list 3 4))
==> (1 2 3 4)

;;; Leading ,@ with no prefix.
>>> `(,@(list 1 2) z)
==> (1 2 z)

;;; Trailing ,@ works.
>>> `(start ,@(list 1 2))
==> (start 1 2)

;;; Expressions inside unquote can be arbitrary.
>>> (define xs '(10 20 30)) `(first is ,(car xs) rest ,@(cdr xs))
==> (first is 10 rest 20 30)

;;; Nested quasiquote - inner form stays literal except for one-level
;;; unquotes at outer level 1.
>>> (define c 100) `(a `b ,c)
==> (a (quasiquote b) 100)

;;; Double-unquote inside nested quasiquote reaches the outer level.
>>> (define c 100) `(a `(b ,,c))
==> (a (quasiquote (b (unquote 100))))

;;; Single unquote inside nested quasiquote stays literal.
>>> (define c 100) `(a `(b ,c))
==> (a (quasiquote (b (unquote c))))

;;; `,x is (quasiquote (unquote x)) which reduces to x's value.
>>> (define v 7) `,v
==> 7

;;; Unquote outside quasiquote is a shape error.
>>> (unquote 5)
%%% line 1, col 1: unquote is only valid inside a quasiquote template
%%% (unquote 5)
%%% ^

>>> (unquote-splicing (list 1 2))
%%% line 1, col 1: unquote-splicing is only valid inside a quasiquote template
%%% (unquote-splicing (list 1 2))
%%% ^

;;; -------- delay / delay-force / force / make-promise (R7RS 4.2.5, 6.10) --------

;;; Basic delay + force.
>>> (force (delay 42))
==> 42

>>> (force (delay (+ 1 2 3)))
==> 6

;;; delay produces a promise; force unwraps it.
>>> (promise? (delay 1))
==> #t

>>> (promise? 1)
==> #f

>>> (promise? "hi")
==> #f

>>> (promise? (lambda () 1))
==> #f

;;; A forced promise stays a promise (still answers #t to promise?).
>>> (define p (delay 7)) (force p) (promise? p)
==> #t

;;; Memoization: the thunk runs at most once.  We count effects by set!-ing
;;; a counter in the delayed body.
>>> (define c 0) (define p (delay (begin (set! c (+ c 1)) 42))) (force p) (force p) (force p) c
==> 1

;;; The value is cached across forces.
>>> (define c 0) (define p (delay (begin (set! c (+ c 1)) 99))) (force p) (force p)
==> 99

;;; make-promise: already-forced, no thunk ever runs.
>>> (force (make-promise 100))
==> 100

>>> (promise? (make-promise 5))
==> #t

;;; make-promise + force is idempotent.
>>> (define q (make-promise 'hello)) (force q) (force q)
==> hello

;;; Closure captures the env at delay time.
>>> (define x 10) (define p (delay (* x x))) (set! x 99) (force p)
==> 9801

;;; A promise whose body yields another promise unwraps transparently.
>>> (force (delay (delay 42)))
==> 42

>>> (force (delay (make-promise 'inner)))
==> inner

;;; delay-force - same observable semantics as delay in our implementation.
>>> (force (delay-force 42))
==> 42

>>> (force (delay-force (delay 17)))
==> 17

;;; Stack-safe iterative forcing: a long chain of delay-force collapses
;;; without building native stack.  100k is well past the recursion limit.
>>> (define (loop n) (if (zero? n) (delay 'done) (delay-force (loop (- n 1))))) (force (loop 100000))
==> done

;;; force on a non-promise returns the value unchanged (R7RS leaves this
;;; implementation-defined; pyscheme follows SRFI 155 and most R6RS impls,
;;; treating non-promises as if already forced).
>>> (force 5)
==> 5

>>> (force '(1 2 3))
==> (1 2 3)

>>> (force "hi")
==> "hi"

;;; Shape errors.
>>> (delay)
%%% line 1, col 1: delay requires exactly 1 argument, got 0
%%% (delay)
%%% ^

>>> (delay 1 2)
%%% line 1, col 1: delay requires exactly 1 argument, got 2
%%% (delay 1 2)
%%% ^

>>> (delay-force)
%%% line 1, col 1: delay-force requires exactly 1 argument, got 0
%%% (delay-force)
%%% ^

;;; help visible for both special forms and procedures.
>>> (help delay)
Special Form  |  args: unevaluated

   Usage: (delay <expr>)

   Return a promise whose forced value is the value of <expr>.
   <expr> is not evaluated until the promise is forced; its value is
   then cached so subsequent forces are O(1).  R7RS 4.2.5.  Use force
   to retrieve the value.
==> #<void>

>>> (help force)
Primitive  |  args: pre-evaluated

   Usage: (force a)

   Force a promise, returning its value.  The promise's thunk runs
   at most once; subsequent forces return the cached value.  If the
   thunk yields another promise, force follows the chain iteratively,
   so (delay-force ...) promise chains run in constant stack.  A
   non-promise argument is returned unchanged (R7RS-small 6.10 leaves
   this implementation-defined; we follow SRFI 155).
==> #<void>

;;; -------- values / call-with-values / let-values / let*-values / define-values (R7RS 4.2.2, 5.3.3, 6.10) --------

;;; (values) returns an empty multi-values.
>>> (values)
==> #<values>

;;; Single-value (values x) unwraps to x.
>>> (values 42)
==> 42

>>> (values "hi")
==> "hi"

;;; (values x) is one value, so it works in single-value contexts: this
;;; is a correctness requirement, not a convention.  R7RS 6.10.
>>> (+ 1 (values 2))
==> 3

>>> (define values-single (values 42)) values-single
==> 42

>>> (if (values #t) (quote yes) (quote no))
==> yes

;;; Two+ values wrap into a multi-values container.
>>> (values 1 2 3)
==> #<values 1 2 3>

;;; call-with-values unpacks multi-values into the consumer's args.
>>> (call-with-values (lambda () (values 10 20 30)) +)
==> 60

>>> (call-with-values (lambda () (values 1 2)) list)
==> (1 2)

;;; Single-value producer: consumer gets one argument.
>>> (call-with-values (lambda () 42) (lambda (x) (* x 2)))
==> 84

;;; Zero-value producer: consumer must take zero args.
>>> (call-with-values (lambda () (values)) (lambda () 'ok))
==> ok

;;; Primitive producer and consumer work too.
>>> (call-with-values (lambda () (values 3 4)) (lambda (a b) (* a b)))
==> 12

;;; Consumer can be variadic.
>>> (call-with-values (lambda () (values 1 2 3 4)) (lambda args args))
==> (1 2 3 4)

;;; -------- let-values: parallel semantics --------

>>> (let-values (((a b) (values 1 2))) (+ a b))
==> 3

>>> (let-values (((a b) (values 10 20)) ((c) (values 30))) (list a b c))
==> (10 20 30)

;;; Parallel: init2 does NOT see clause-1 bindings.  Define x in the
;;; outer env; let-values shadows with its own x only when the body runs.
>>> (define x 100) (let-values (((x) (values 1)) ((y) (values x))) (list x y))
==> (1 100)

;;; Variadic rest in formals: rest gets the tail of the value list.
>>> (let-values (((head . rest) (values 1 2 3 4))) (list head rest))
==> (1 (2 3 4))

;;; Pure-variadic formals: the single identifier gets the whole value list.
>>> (let-values ((all (values 'a 'b 'c))) all)
==> (a b c)

;;; Empty bindings degenerates to begin.
>>> (let-values () 1 2 3)
==> 3

;;; Zero-value init is legal when formals is ().
>>> (let-values ((() (values))) 'body-ran)
==> body-ran

;;; -------- let*-values: sequential semantics --------

>>> (let*-values (((a b) (values 1 2)) ((c) (values (+ a b)))) c)
==> 3

>>> (let*-values (((x) (values 10)) ((x) (values (* x x)))) x)
==> 100

;;; -------- define-values --------

>>> (define-values (p q r) (values 1 2 3)) (list p q r)
==> (1 2 3)

;;; define-values with dotted rest.
>>> (define-values (head . tail) (values 10 20 30 40)) (list head tail)
==> (10 (20 30 40))

;;; define-values with pure-variadic formals.
>>> (define-values all (values 'x 'y 'z)) all
==> (x y z)

;;; Single-value init becomes single binding.
>>> (define-values (solo) 77) solo
==> 77

;;; -------- multi-values as single-value error --------

;;; Delivering multi-values into an argument slot is an error.  The
;;; error position points at the offending (values ...) call site.
>>> (+ 1 (values 2 3))
%%% SchemeTypeError: line 1, col 6: multiple values delivered to a single-value context
%%% (+ 1 (values 2 3))
%%%      ^

;;; Same in an if-test.
>>> (if (values 1 2) 'yes 'no)
%%% SchemeTypeError: line 1, col 5: multiple values delivered to a single-value context
%%% (if (values 1 2) 'yes 'no)
%%%     ^

;;; Same in a let init.
>>> (let ((x (values 1 2))) x)
%%% SchemeTypeError: line 1, col 10: multiple values delivered to a single-value context
%%% (let ((x (values 1 2))) x)
%%%          ^

;;; Same in a define right-hand side.
>>> (define mv-bad (values 1 2))
%%% SchemeTypeError: line 1, col 16: multiple values delivered to a single-value context
%%% (define mv-bad (values 1 2))
%%%                ^

;;; -------- multi-values legitimately allowed --------

;;; Intermediate forms in begin discard their value: 0-value context, not
;;; a single-value context, so multi-values are fine.
>>> (begin (values 1 2) (+ 3 4))
==> 7

;;; Internal body sequencing in lambda / let* discards intermediates too.
>>> (let () (values 1 2) 'ok)
==> ok

;;; The last form's value is what flows out, as usual.
>>> (define mv-tail (begin (values 1 2) 42)) mv-tail
==> 42

;;; dynamic-wind is transparent to the body's return value: multi-values
;;; flow through the after-thunk to the surrounding call-with-values.
>>> (call-with-values (lambda () (dynamic-wind (lambda () #f) (lambda () (values 1 2)) (lambda () #f))) +)
==> 3

;;; with-exception-handler that doesn't fire is also transparent.
>>> (call-with-values (lambda () (with-exception-handler (lambda (v) 'unused) (lambda () (values 5 7)))) +)
==> 12

;;; Deep tail recursion through call-with-values: each iteration tail-calls
;;; loop via call-with-values.  Without CEK-level dispatch this would blow
;;; Python stack.
>>> (define (loop n) (if (zero? n) 'done (call-with-values (lambda () (values (- n 1))) loop))) (loop 100000)
==> done

;;; -------- shape errors --------

>>> (let-values)
%%% SchemeArityError: line 1, col 1: let-values: 0 arguments provided; at least 2 expected
%%% (let-values)
%%% ^

>>> (define-values)
%%% SchemeArityError: line 1, col 1: define-values: 0 arguments provided; 2 expected
%%% (define-values)
%%% ^

;;; -------- internal definitions hoist into letrec* (R7RS 5.3.2) --------

;;; Mutually-recursive procedures defined via internal define: each
;;; closure captures the body env, so forward references resolve at
;;; call time.  This already worked without hoisting; the test pins the
;;; behavior.
>>> (let () (define f (lambda () (g))) (define g (lambda () 42)) (f))
==> 42

;;; Sequential init: y's init may reference x because x is bound first.
>>> (let () (define x 1) (define y (+ x 1)) y)
==> 2

;;; Mutual reference between define-values and define via closure capture.
>>> (let () (define h (lambda () g)) (define-values (g) 99) (h))
==> 99

;;; define and define-values mixed: all visible to body.
>>> (let () (define x 1) (define-values (a b) (values 2 3)) (define y 4) (list x a b y))
==> (1 2 3 4)

;;; Internal (begin ...) splices its contents into the body, so a
;;; define inside a body-position begin participates in hoisting.
>>> (let () (begin (define x 10) (define y 20)) (+ x y))
==> 30

;;; lambda body also hoists.
>>> ((lambda () (define x 100) (define y (+ x 1)) y))
==> 101

;;; case-lambda hoists per clause.
>>> ((case-lambda ((x) (define y 100) (+ x y)) ((x y) (* x y))) 5)
==> 105

;;; when / unless body hoists.
>>> (when #t (define x 7) (define y 8) (+ x y))
==> 15

>>> (unless #f (define-values (a b) (values 5 6)) (* a b))
==> 30

;;; let*-values body hoists.
>>> (let*-values (((a) (values 10))) (define b (+ a 1)) (define c (* b 2)) c)
==> 22

;;; parameterize body hoists.
>>> (parameterize () (define z 9) (* z z))
==> 81

;;; guard body hoists.
>>> (guard (e (#t e)) (define ok 42) ok)
==> 42

;;; -------- define-record-type (R7RS 5.5) --------

;;; Basic: constructor, predicate, accessors.
>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point-x (make-point 3 4))
==> 3

>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point-y (make-point 3 4))
==> 4

;;; Predicate distinguishes records from other values.
>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point? (make-point 0 0))
==> #t

>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point? 42)
==> #f

>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point? '(3 4))
==> #f

>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (point? "hi")
==> #f

;;; pair? and null? reject records (disjoint type).
>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (pair? (make-point 1 2))
==> #f

>>> (define-record-type point (make-point x y) point? (x point-x) (y point-y)) (null? (make-point 1 2))
==> #f

;;; Mutator changes the field.
>>> (define-record-type box (make-box v) box? (v box-v set-box-v!)) (define b (make-box 10)) (set-box-v! b 99) (box-v b)
==> 99

;;; Mutator returns void.
