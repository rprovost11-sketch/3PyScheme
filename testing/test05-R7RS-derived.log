==> (1 2 3)

>>> (define-syntax my-list (syntax-rules () ((_ x ...) (list x ...)))) (my-list)
==> ()

;;; Multiple rules match by shape.
>>> (define-syntax pick (syntax-rules () ((_) 'none) ((_ x) (list 'one x)) ((_ x y) (list 'two x y)))) (pick)
==> none

>>> (define-syntax pick (syntax-rules () ((_) 'none) ((_ x) (list 'one x)) ((_ x y) (list 'two x y)))) (pick 1)
==> (one 1)

>>> (define-syntax pick (syntax-rules () ((_) 'none) ((_ x) (list 'one x)) ((_ x y) (list 'two x y)))) (pick 1 2)
==> (two 1 2)

;;; Literals match exact symbols in the form.
>>> (define-syntax my-when-even (syntax-rules (then) ((_ test then body) (if test body #f)))) (my-when-even #t then 99)
==> 99

;;; Hygiene: a template temporary doesn't capture a user name of the
;;; same name at the use site.
>>> (define-syntax swap! (syntax-rules () ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp))))) (define tmp 'user) (define x 10) (define y 20) (swap! x y) (list x y tmp)
==> (20 10 user)

;;; Free identifiers in templates (like list, +) resolve to their
;;; definition-time values, not the use-site bindings.
>>> (define-syntax one-more (syntax-rules () ((_ n) (+ n 1)))) (let ((+ -)) (one-more 5))
==> 6

;;; Recursive macros via letrec-syntax.
>>> (letrec-syntax ((my-or (syntax-rules () ((_) #f) ((_ a) a) ((_ a b ...) (let ((t a)) (if t t (my-or b ...))))))) (my-or #f #f 42 #f))
==> 42

>>> (letrec-syntax ((my-or (syntax-rules () ((_) #f) ((_ a) a) ((_ a b ...) (let ((t a)) (if t t (my-or b ...))))))) (my-or #f #f))
==> #f

;;; Recursive macro via define-syntax.
>>> (define-syntax my-and (syntax-rules () ((_) #t) ((_ a) a) ((_ a b ...) (if a (my-and b ...) #f)))) (my-and 1 2 3 4)
==> 4

>>> (define-syntax my-and (syntax-rules () ((_) #t) ((_ a) a) ((_ a b ...) (if a (my-and b ...) #f)))) (my-and 1 #f 3)
==> #f

>>> (define-syntax my-and (syntax-rules () ((_) #t) ((_ a) a) ((_ a b ...) (if a (my-and b ...) #f)))) (my-and)
==> #t

;;; let-syntax: local transformer, isolated from siblings.
>>> (let-syntax ((sq (syntax-rules () ((_ x) (* x x))))) (sq 9))
==> 81

;;; let-syntax with multiple bindings; each body scope sees all of them.
>>> (let-syntax ((sq (syntax-rules () ((_ x) (* x x)))) (cb (syntax-rules () ((_ x) (* x x x))))) (list (sq 3) (cb 3)))
==> (9 27)

