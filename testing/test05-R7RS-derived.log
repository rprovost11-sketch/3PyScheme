;;; -------- define-syntax / syntax-rules (R7RS 4.3) --------

;;; Basic pattern + template.
>>> (define-syntax my-when (syntax-rules () ((_ test body ...) (if test (begin body ...) #f)))) (my-when #t 1 2 3)
