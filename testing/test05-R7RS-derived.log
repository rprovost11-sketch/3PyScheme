;;; -------- raise / with-exception-handler / guard / error objects (R7RS 4.2.7, 6.11) --------

;;; raise + with-exception-handler: handler receives the raised value.
>>> (with-exception-handler (lambda (v) (list 'caught v)) (lambda () (raise 'boom)))
==> (caught boom)

;;; Raised value can be anything - symbol, number, string, list, record.
>>> (with-exception-handler (lambda (v) v) (lambda () (raise 42)))
==> 42

>>> (with-exception-handler (lambda (v) v) (lambda () (raise "oops")))
==> "oops"

>>> (with-exception-handler (lambda (v) v) (lambda () (raise '(1 2 3))))
==> (1 2 3)

;;; Thunk runs normally when no raise fires.
>>> (with-exception-handler (lambda (v) 'never) (lambda () (+ 1 2 3)))
==> 6

;;; error primitive produces an error object catchable as any other raise.
>>> (with-exception-handler (lambda (v) (error-object? v)) (lambda () (error "bad" 1 2 3)))
==> #t

>>> (with-exception-handler (lambda (v) (error-object-message v)) (lambda () (error "bad thing")))
==> "bad thing"

>>> (with-exception-handler (lambda (v) (error-object-irritants v)) (lambda () (error "bad" 1 2 3)))
==> (1 2 3)

;;; error without irritants: irritants is the empty list.
>>> (with-exception-handler (lambda (v) (error-object-irritants v)) (lambda () (error "oops")))
==> ()

;;; error-object? on non-error-object.
>>> (error-object? 42)
==> #f

>>> (error-object? "string")
==> #f

;;; error-object-message on a non-error-object is a type error.
>>> (error-object-message 42)
%%% SchemeTypeError: line 1, col 1: error-object-message: not an error object
%%% (error-object-message 42)
%%% ^

;;; raise-continuable: handler's result flows back to the raise-continuable
;;; call site (R7RS 6.11).  In a sole-form thunk this looks the same as
;;; "handler return == with-exception-handler return".
>>> (with-exception-handler (lambda (v) (+ v 1)) (lambda () (raise-continuable 100)))
==> 101

;;; ...but in a composite expression, the handler's return value is the
;;; raise-continuable's value, not the with-exception-handler's value.
>>> (with-exception-handler (lambda (v) (+ v 1)) (lambda () (+ 1 (raise-continuable 100))))
==> 102

;;; Deep tail recursion through with-exception-handler.  FRAME_POP_HANDLER
;;; in the CEK keeps Python stack flat across iterations.
>>> (define (loop n) (with-exception-handler (lambda (v) v) (lambda () (if (zero? n) 'done (loop (- n 1)))))) (loop 100000)
==> done

;;; guard: first matching clause wins, its body is the guard's return.
>>> (guard (e ((symbol? e) (list 'sym e)) ((number? e) (list 'num e))) (raise 'alpha))
==> (sym alpha)

>>> (guard (e ((symbol? e) (list 'sym e)) ((number? e) (list 'num e))) (raise 42))
==> (num 42)

;;; guard: no matching clause and no else -> re-raise the original value.
>>> (guard (e ((string? e) 'got-string)) (raise 99))
%%% SchemeRaised: line 1, col 1: 99
%%% (guard (e ((string? e) 'got-string)) (raise 99))
%%% ^

;;; guard: explicit else catches anything not matched above.
>>> (guard (e ((symbol? e) 'sym) (else (list 'other e))) (raise 3.14))
==> (other 3.14)

;;; guard around error: the handler receives an error-object.
>>> (guard (e ((error-object? e) (error-object-message e))) (error "bad" 1 2))
==> "bad"

;;; guard body returns normally when no exception fires.
>>> (guard (e (else 'never)) (+ 1 2 3))
==> 6

;;; guard composes: inner guard catches, outer sees nothing.
>>> (guard (e (else 'outer-caught)) (guard (e (else (list 'inner e))) (raise 'boom)))
==> (inner boom)

;;; guard re-raises to outer guard when inner has no match.
