;;; -------- synthesized-name hygiene --------
;;; The desugarings for do, let-values, let*-values, define-values, and
;;; define-record-type used to build synthetic identifiers ('%do-loop%',
;;; '%mv0', '%mv-tmp0', '%record-type:NAME').  Those would collide with
;;; user-chosen names.  Each is now produced by hygiene_gensym.

;;; let-values: a user binding named %mv0 must survive the let-values body.
>>> (let ((%mv0 'outer)) (let-values (((a) (values 1))) (list %mv0 a)))
==> (outer 1)

;;; let*-values: same with a sequential clause chain.
>>> (let ((%mv1 'outer)) (let*-values (((a) (values 1)) ((b) (values 2))) (list %mv1 a b)))
==> (outer 1 2)

;;; define-values: %mv-tmp0 / %mv-tmp-rest used to leak.
>>> (let ((%mv-tmp0 'outer)) (define-values (a b) (values 1 2)) (list %mv-tmp0 a b))
==> (outer 1 2)

;;; do: a user binding named %do-loop% must not be shadowed by the loop.
>>> (let ((%do-loop% 'outer)) (do ((i 0 (+ i 1))) ((= i 3) %do-loop%)))
==> outer

;;; define-record-type: the hidden type descriptor used to be named
;;; %record-type:point in the global env; a user binding of that name
;;; would have collided with the record machinery.
>>> (define %record-type:thing 'mine) (define-record-type thing (make-thing) thing?) %record-type:thing
==> mine

;;; -------- make-parameter / parameterize (R7RS 4.2.6, 6.10) --------

;;; make-parameter returns a parameter object.
>>> (make-parameter 10)
==> #<parameter>

>>> (parameter? (make-parameter 10))
==> #t

>>> (parameter? 42)
==> #f

;;; parameter? sits with the type predicates; procedure? also says yes.
>>> (procedure? (make-parameter 10))
==> #t

;;; Reading a parameter: 0-arg call returns the current dynamic value.
>>> (define p (make-parameter 10)) (p)
==> 10

;;; parameterize binds dynamically for the body's extent.
>>> (define p (make-parameter 10)) (parameterize ((p 99)) (p))
==> 99

;;; After parameterize returns, the old value is restored.
>>> (define p (make-parameter 10)) (parameterize ((p 99)) (p)) (p)
==> 10

;;; Nested parameterize: the inner binding wins, then is restored.
>>> (define p (make-parameter 1)) (parameterize ((p 2)) (parameterize ((p 3)) (p)))
==> 3

>>> (define p (make-parameter 1)) (parameterize ((p 2)) (parameterize ((p 3)) (p)) (p))
==> 2

;;; Multiple parameters in one parameterize.
>>> (define p (make-parameter 1)) (define q (make-parameter 2)) (parameterize ((p 10) (q 20)) (+ (p) (q)))
==> 30

;;; Converter applied at make-parameter time and at each parameterize binding.
>>> (define c (make-parameter 3 (lambda (x) (* x x)))) (c)
==> 9

>>> (define c (make-parameter 3 (lambda (x) (* x x)))) (parameterize ((c 5)) (c))
==> 25

;;; Converter applies to each parameterize value, not just once.
>>> (define c (make-parameter 1 (lambda (x) (+ x 100)))) (list (c) (parameterize ((c 2)) (c)) (parameterize ((c 3)) (c)) (c))
==> (101 102 103 101)

;;; Deep tail recursion through parameterize: each iteration tail-calls
;;; loop inside a parameterize body.  Without CEK-level integration this
;;; would blow Python stack.  K grows O(n) here but Python stack does not.
>>> (define p (make-parameter 0)) (define (loop n) (if (zero? n) (p) (parameterize ((p (+ (p) 1))) (loop (- n 1))))) (loop 100000)
==> 100000

;;; Exception safety: parameterize restores even when body raises.
>>> (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom"))
%%% SchemeUserError: line 1, col 54: boom
%%% (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom"))
%%%                                                      ^

>>> (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom")) (p)
%%% SchemeUserError: line 1, col 54: boom
%%% (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom")) (p)
%%%                                                      ^

;;; After catching such an error (here just reading p on a fresh line), p
;;; is back to its original value.
>>> (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom")) #f (p)
%%% SchemeUserError: line 1, col 54: boom
%%% (define p (make-parameter 1)) (parameterize ((p 99)) (error "boom")) #f (p)
%%%                                                      ^

