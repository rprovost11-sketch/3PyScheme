;;; ============================================================
;;; test12-hygiene.log
;;; Sets-of-scopes hygiene: macro expansion correctness.
;;; Tests the Phase 4-5 sets-of-scopes implementation.
;;; Key fix: let-syntax inside a macro template no longer captures
;;; same-named identifiers from the use site.
;;; ============================================================

;;; -------- Primary fix: let-syntax binding in macro template --------

;;; When a macro's template contains (let-syntax ((h ...)) ...), the
;;; inner h must shadow any h at the use site.  Previously failed
;;; with "let-syntax: malformed binding" because the use-site h
;;; transformer value was substituted into the binding position.

>>> (define-syntax hyg-m
...   (syntax-rules ()
...     ((_) (let-syntax ((hyg-h (syntax-rules () ((_) 99)))) (hyg-h)))))
==> #<void>

>>> (let-syntax ((hyg-h (syntax-rules () ((_) 0)))) (hyg-m))
==> 99

;;; -------- swap! hygiene --------

;;; The introduced tmp binding in swap! must not capture or be
;;; captured by a user-defined variable also named tmp.

>>> (define-syntax hyg-swap!
...   (syntax-rules ()
...     ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))
==> #<void>

>>> (define hyg-tmp 99)
==> #<void>

>>> (define hyg-p 1)
==> #<void>

>>> (define hyg-q 2)
==> #<void>

>>> (hyg-swap! hyg-p hyg-q)
==> #<void>

;;; hyg-p and hyg-q are swapped; hyg-tmp is unchanged
>>> (list hyg-p hyg-q hyg-tmp)
==> (2 1 99)

;;; -------- or no variable capture --------

;;; The built-in or macro introduces a temporary binding.  A user
;;; variable t in scope must not be shadowed by that introduced temp.

>>> (let ((t 42)) (or #f t))
==> 42

;;; -------- cross-macro reference (macro calls later-defined macro) --------

;;; A free identifier in a macro template that refers to a macro
;;; defined after the current one must be resolved at expansion time,
;;; not locked to the (empty) def-env at definition time.

>>> (define-syntax hyg-m1 (syntax-rules () ((_ x) (hyg-m2 x))))
==> #<void>

>>> (define-syntax hyg-m2 (syntax-rules () ((_ x) (* x x))))
==> #<void>

>>> (hyg-m1 7)
==> 49

;;; -------- letrec-syntax one-way reference --------

;;; A macro defined earlier in letrec-syntax can call one defined
;;; later, even though the later one is not in the earlier macro's
;;; def-env.  The reference is resolved via scope-aware lookup.

>>> (letrec-syntax
...   ((lfoo (syntax-rules () ((_) (lbar))))
...    (lbar (syntax-rules () ((_) 42))))
...   (lfoo))
==> 42

;;; -------- def-env captures binding at definition time --------

;;; A free id in a macro template that is bound at definition time
;;; resolves to the definition-time binding, even if the same name
;;; is rebound at the use site.

>>> (define defenv-x 1)
==> #<void>

>>> (let-syntax ((dm (syntax-rules () ((_) defenv-x))))
...   (let ((defenv-x 99))
...     (dm)))
==> 1

;;; -------- let-syntax lexical shadowing --------

;;; Nested let-syntax forms correctly shadow each other.

>>> (let-syntax ((hs (syntax-rules () ((_) 0))))
...   (let-syntax ((hs (syntax-rules () ((_) 1))))
...     (hs)))
==> 1

;;; -------- recursive macro with ellipsis (my-or) --------

;;; A macro that recurses on its argument list terminates correctly
;;; because the ellipsis argument count shrinks each step.

>>> (define-syntax my-or
...   (syntax-rules ()
...     ((_) #f)
...     ((_ e) e)
...     ((_ e1 e2 ...)
...      (let ((ort e1))
...        (if ort ort (my-or e2 ...))))))
==> #<void>

>>> (my-or #f #f 42)
==> 42

>>> (my-or #f #f #f)
==> #f

>>> (my-or 1 2 3)
==> 1

;;; -------- ellipsis template expansion --------

>>> (define-syntax my-list2 (syntax-rules () ((_ x ...) (list x ...))))
==> #<void>

>>> (my-list2 1 2 3)
==> (1 2 3)

>>> (my-list2)
==> ()

;;; -------- literal identifier in pattern --------

>>> (define-syntax my-if
...   (syntax-rules (then else)
...     ((_ c then t else e) (if c t e))))
==> #<void>

>>> (my-if #f then 1 else 2)
==> 2

>>> (my-if #t then 10 else 20)
==> 10

;;; -------- nested macro expansion --------

;;; A macro whose expansion contains another macro call is expanded
;;; correctly by the iterative Expander.

>>> (define-syntax add1x (syntax-rules () ((_ x) (+ x 1))))
==> #<void>

>>> (define-syntax add2x (syntax-rules () ((_ x) (add1x (add1x x)))))
==> #<void>

>>> (add2x 10)
==> 12

;;; -------- introduced binding does not shadow pattern variable --------

;;; When a macro introduces a binding named t and the user passes a
;;; variable also named t, the user's value is returned unchanged.

>>> (define-syntax scm
...   (syntax-rules ()
...     ((_ x) (let ((sct 99)) x))))
==> #<void>

>>> (let ((sct 42)) (scm sct))
==> 99
