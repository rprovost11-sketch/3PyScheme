;;; ============================================================
;;; test20-compliance.log
;;; R7RS-small compliance corrections:
;;;   equal? on vectors, bytevectors, and circular structures;
;;;   write-string optional start/end;
;;;   read-bytevector optional port;
;;;   read-bytevector! optional port;
;;;   write-u8 optional port;
;;;   write-bytevector optional port.
;;; ============================================================

;;; -------- equal? on vectors --------

>>> (equal? (vector 1 2) (vector 1 2))
==> #t

>>> (equal? (vector 1 2) (vector 1 3))
==> #f

>>> (equal? (vector 1 2) (vector 1 2 3))
==> #f

>>> (equal? (vector) (vector))
==> #t

>>> (equal? (vector (list 1 2) "x") (vector (list 1 2) "x"))
==> #t

>>> (equal? (vector (list 1 2)) (vector (list 1 3)))
==> #f

;;; -------- equal? on bytevectors --------

>>> (equal? (bytevector 1 2 3) (bytevector 1 2 3))
==> #t

>>> (equal? (bytevector 1 2 3) (bytevector 1 2 4))
==> #f

>>> (equal? (bytevector) (bytevector))
==> #t

>>> (equal? (bytevector 1) (bytevector 1 2))
==> #f

;;; -------- equal? mixed nesting --------

>>> (equal? (list 1 (vector 2 3)) (list 1 (vector 2 3)))
==> #t

>>> (equal? (list 1 (bytevector 2 3)) (list 1 (bytevector 2 3)))
==> #t

>>> (equal? (vector (list 1) (bytevector 2)) (vector (list 1) (bytevector 2)))
==> #t

;;; -------- equal? on circular structures - must not crash --------

>>> (let ((x (list 1 2 3))) (set-car! x x) (equal? x x))
==> #t

;;; -------- write-string optional start/end --------

>>> (let ((p (open-output-string))) (write-string "hello" p) (get-output-string p))
==> "hello"

>>> (let ((p (open-output-string))) (write-string "hello" p 1) (get-output-string p))
==> "ello"

>>> (let ((p (open-output-string))) (write-string "hello" p 1 3) (get-output-string p))
==> "el"

>>> (let ((p (open-output-string))) (write-string "hello" p 0 0) (get-output-string p))
==> ""

>>> (let ((p (open-output-string))) (write-string "hello" p 5 5) (get-output-string p))
==> ""

;;; -------- read-bytevector optional port --------

>>> (let ((p (open-input-bytevector (bytevector 1 2 3)))) (read-bytevector 2 p))
==> #u8(1 2)

>>> (let ((p (open-input-bytevector (bytevector 1 2 3)))) (read-bytevector 3 p))
==> #u8(1 2 3)

>>> (let ((p (open-input-bytevector (bytevector)))) (eof-object? (read-bytevector 1 p)))
==> #t

;;; -------- read-bytevector! optional port --------

>>> (let ((bv (make-bytevector 3 0)) (p (open-input-bytevector (bytevector 5 6 7)))) (read-bytevector! bv p) bv)
==> #u8(5 6 7)

>>> (let ((bv (make-bytevector 4 0)) (p (open-input-bytevector (bytevector 9 8 7)))) (read-bytevector! bv p 1 4) bv)
==> #u8(0 9 8 7)

;;; -------- write-u8 optional port --------

>>> (let ((p (open-output-bytevector))) (write-u8 65 p) (get-output-bytevector p))
==> #u8(65)

>>> (let ((p (open-output-bytevector))) (write-u8 0 p) (write-u8 255 p) (get-output-bytevector p))
==> #u8(0 255)

;;; -------- write-bytevector optional port --------

>>> (let ((p (open-output-bytevector))) (write-bytevector (bytevector 1 2 3) p) (get-output-bytevector p))
==> #u8(1 2 3)

>>> (let ((p (open-output-bytevector))) (write-bytevector (bytevector 1 2 3 4) p 1 3) (get-output-bytevector p))
==> #u8(2 3)

>>> (let ((p (open-output-bytevector))) (write-bytevector (bytevector 10 20 30) p 0 0) (get-output-bytevector p))
==> #u8()
