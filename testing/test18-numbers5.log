;;; ============================================================
;;; test18-numbers5.log
;;; R7RS §6.2 numeric tower Phase 5:
;;;   rationalize
;;;   polar complex literal a@b
;;;   string->number #e on non-integer real
;;;   transcendental auto-promotion to complex (log, asin, acos)
;;; ============================================================

;;; -------- rationalize (exact) --------

;;; Simplest rational in [7/30, 13/30].
>>> (rationalize 1/3 1/10)
==> 1/3

;;; Interval [1/5, 2/5] still simplest = 1/3.
>>> (rationalize 3/10 1/10)
==> 1/3

;;; Negative: simplest rational in [-13/30, -7/30].
>>> (rationalize -1/3 1/10)
==> -1/3

;;; Interval straddles zero -> 0.
>>> (rationalize 1/4 1/4)
==> 0

;;; Zero delta: return exact x.
>>> (rationalize 1/3 0)
==> 1/3

;;; Zero x, zero delta.
>>> (rationalize 0 0)
==> 0

;;; -------- rationalize (inexact) --------

;;; Inexact input -> inexact result.
>>> (rationalize 0.3 0.1)
==> 0.3333333333333333

;;; Interval [0.0, 0.2] straddles zero -> inexact 0.
>>> (rationalize 0.0 0.1)
==> 0.0

;;; Infinite delta -> 0.0 (inexact).
>>> (rationalize 1 +inf.0)
==> 0.0

;;; Infinite x -> return x unchanged.
>>> (rationalize +inf.0 1)
==> +inf.0

;;; -------- polar complex literal a@b --------

;;; r=1, theta=0: pure real.
>>> 1@0
==> 1.0+0.0i

;;; r=2, theta=0.
>>> 2@0
==> 2.0+0.0i

;;; Polar literal equals make-polar with same arguments.
>>> (= 1@0 (make-polar 1 0))
==> #t

;;; Polar and rectangular agree for r=5, theta=0.
>>> (= 5@0 5+0i)
==> #t

;;; -------- string->number with #e on non-integer reals --------

;;; #e1.5 -> exact rational 3/2.
>>> (string->number "#e1.5")
==> 3/2

;;; #e0.5 -> 1/2.
>>> (string->number "#e0.5")
==> 1/2

;;; #e2.0 -> integer 2 (2.0 is_integer).
>>> (string->number "#e2.0")
==> 2

;;; #e0.0 -> integer 0.
>>> (string->number "#e0.0")
==> 0

;;; -------- transcendental auto-promotion to complex --------

;;; log of negative real -> complex (principal value).
>>> (log -1)
==> 0.0+3.141592653589793i

>>> (log -2)
==> 0.6931471805599453+3.141592653589793i

;;; asin outside [-1, 1] -> complex.
>>> (asin 2)
==> 1.5707963267948966+1.3169578969248166i

>>> (asin -2)
==> -1.5707963267948966+1.3169578969248166i

;;; acos outside [-1, 1] -> complex.
>>> (acos 2)
==> 0.0-1.3169578969248166i

;;; -------- sqrt -0.0 --------

;;; R7RS treats -0.0 as 0 for sqrt; result is exact zero, not -0.0.
>>> (sqrt -0.0)
==> 0.0

;;; -------- angle +nan.0 --------

;;; NaN argument propagates through angle.
>>> (angle +nan.0)
==> +nan.0

;;; -------- expt with clean complex result --------

;;; (-1)^(1/2) = 0+i exactly (no IEEE noise in real part).
>>> (expt -1 1/2)
==> 0.0+1.0i

;;; -------- integer-division ops accept inexact integer-valued args --------

;;; R7RS §6.2.6 explicit example: (gcd 32.0 -36) => 4.0
>>> (gcd 32.0 -36)
==> 4.0

>>> (lcm 32.0 -36)
==> 288.0

>>> (quotient 13.0 4)
==> 3.0

>>> (remainder 13 4.0)
==> 1.0

>>> (modulo -13.0 4)
==> 3.0

>>> (floor-quotient 5.0 2)
==> 2.0

>>> (floor-remainder 13 4.0)
==> 1.0

>>> (truncate-quotient -13.0 4)
==> -3.0

>>> (truncate-remainder -13 4.0)
==> -1.0

;;; -------- exact complex numbers --------

;;; Exact complex literals are exact.
>>> (exact? 3+4i)
==> #t

>>> (exact? 1/3+1/2i)
==> #t

>>> (inexact? 3+4i)
==> #f

;;; inexact converts to inexact complex.
>>> (inexact 3+4i)
==> 3.0+4.0i

;;; exact of inexact complex converts each component.
>>> (exact 3.0+4.0i)
==> 3+4i

;;; Arithmetic on exact complex produces exact results.
>>> (+ 1+2i 3+4i)
==> 4+6i

>>> (- 5+3i 2+1i)
==> 3+2i

;;; Product with conjugate -> exact integer.
>>> (* 1+1i 1-1i)
==> 2

;;; Division -> exact rational complex.
>>> (/ 1+2i 3+4i)
==> 11/25+2/25i

;;; Components return exact values.
>>> (real-part 3+4i)
==> 3

>>> (imag-part 1/3+1/2i)
==> 1/2

;;; make-rectangular with exact args -> exact complex.
>>> (make-rectangular 1/3 1/2)
==> 1/3+1/2i

;;; magnitude always inexact.
>>> (magnitude 3+4i)
==> 5.0

;;; Type predicates.
>>> (number? 3+4i)
==> #t

>>> (complex? 3+4i)
==> #t

>>> (real? 3+4i)
==> #f

>>> (rational? 3+4i)
==> #f

>>> (integer? 3+4i)
==> #f

>>> (finite? 3+4i)
==> #t

;;; Numerical equality across exact/inexact.
>>> (= 3+4i 3.0+4.0i)
==> #t

;;; eqv? and equal? on exact complex.
>>> (eqv? 3+4i 3+4i)
==> #t

>>> (equal? 1/3+1/2i 1/3+1/2i)
==> #t

;;; number->string for exact complex.
>>> (number->string 1/3+1/2i)
==> "1/3+1/2i"

;;; string->number with #e prefix produces exact complex.
>>> (string->number "#e3.0+4.0i")
==> 3+4i
