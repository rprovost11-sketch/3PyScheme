...   ((1) 'one)
...   ((2) 'two)
...   (else 'other))
==> other

>>> (case 1
...   ((1 2 3) 'small)
...   ((4 5 6) 'medium))
... ; case with => arrow
==> small

>>> (case (* 2 3)
...   ((2 3 5 7) 'prime)
...   ((1 4 6 8 9) => (lambda (x) (list 'composite x)))
...   (else 'other))
... ; else => arrow
==> (composite 6)

>>> (case 'foo
...   ((bar baz) 'nope)
...   (else => (lambda (x) (list 'got x))))
... ; single-datum clause with =>
==> (got foo)

>>> (case 10
...   ((10) => (lambda (x) (* x x))))
... ; no-arrow case still works alongside => tests
==> 100

>>> (case 99
...   ((1 2 3) 'low)
...   ((10 20 30) 'mid)
...   (else 'high))
... ; --- and ---
==> high

>>> (and 1 #f 3)
... ; short-circuit: second form not evaluated
==> #f

>>> (and #f (error "never"))
==> #f

>>> (and 1 2 #f)
... ; --- or ---
==> #f

>>> (or #f)
==> #f

