>>> (quote 42)
==> 42

>>> (quote hello)
==> hello

>>> (quote (1 2 3))
==> (1 2 3)

>>> ''x
... ; --- if ---
==> (quote x)

>>> (if #f 1 2)
... ; non-#f values are truthy
==> 2

>>> (if 0 'yes 'no)
==> yes

>>> (if '() 'yes 'no)
... ; one-armed if
==> yes

>>> (if #f 'never)
==> #<void>

>>> (if #t 'yes)
... ; malformed if
==> yes

>>> (if #t)
%%% line 1, col 1: if requires 2 or 3 arguments (test, then, optional else), got 1
%%% (if #t)
%%% ^

>>> (cond (#f 1) (#t 2))
==> 2

>>> (cond (#f 1) (#f 2) (else 3))
==> 3

>>> (cond (#f 'never) (else 'default))
==> default

>>> (cond ((= 1 1) 'yes) (else 'no))
... ; cond with => arrow
==> yes

>>> (cond ((assv 2 '((1 one) (2 two) (3 three))) => cadr)
...       (else 'not-found))
==> two

>>> (cond (#f => car)
...       (42 => (lambda (x) (* x 2))))
==> 84

>>> (cond (#f => car)
...       (#f => cdr)
...       (else 'none))
==> none

>>> (cond ('() => null?)
...       (else #f))
... ; test value is passed to the arrow procedure (not just truthiness)
==> #t

>>> (cond ((+ 3 4) => (lambda (n) (* n n))))
... ; --- case ---
==> 49

>>> (case 2
...   ((1) 'one)
...   ((2) 'two)
...   ((3) 'three))
==> two

