>>> (define-values (a b c) (values 1 2 3))
==> #<void>

>>> b
==> 2

>>> c
... ; --- let-values ---
... ; basic: bind two values
==> 3

>>> (let-values (((a b) (values 1 2))) (+ a b))
... ; single value binding
==> 3

>>> (let-values (((x) (values 42))) x)
... ; multiple clauses
==> 42

>>> (let-values (((a b) (values 1 2))
...              ((c d) (values 3 4)))
...   (list a b c d))
... ; rest binding (dotted formals)
==> (1 2 3 4)

>>> (let-values (((first . rest) (values 1 2 3)))
...   (list first rest))
... ; pure rest (all values into one list)
==> (1 (2 3))

>>> (let-values ((all (values 1 2 3)))
...   all)
... ; no bindings
==> (1 2 3)

>>> (let-values () 99)
... ; nested let-values
==> 99

>>> (let-values (((x y) (values 10 20)))
...   (let-values (((a b) (values x y)))
...     (* a b)))
... ; --- let*-values ---
... ; basic: same as let-values for non-dependent bindings
==> 200

>>> (let*-values (((a b) (values 1 2))
...               ((c d) (values 3 4)))
...   (list a b c d))
... ; sequential: second clause can use first binding's names
==> (1 2 3 4)

>>> (let*-values (((x) (values 5))
...               ((y) (values x)))
...   y)
... ; --- quasiquote: basic (no unquote) ---
==> 5

