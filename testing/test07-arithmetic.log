;;; ============================================================
;;; test07-arithmetic.log
;;; Arithmetic primitives (+, -, *, /, abs, quotient, remainder,
;;; modulo, min, max) and numeric comparisons (=, <, >, <=, >=).
;;; ============================================================

;;; -------- Arithmetic primitives --------

>>> (+)
==> 0

>>> (+ 1 2 3 4 5)
==> 15

>>> (- 10)
==> -10

>>> (- 10 1 2 3)
==> 4

>>> (*)
==> 1

>>> (* 2 3 4)
==> 24

>>> (/ 12 3)
==> 4

>>> (/ 1 0)
%%% SchemeTypeError: line 1, col 1: /: division by zero
%%% (/ 1 0)
%%% ^

>>> (abs -42)
==> 42

>>> (abs 42)
==> 42

>>> (quotient 13 4)
==> 3

>>> (quotient -13 4)
==> -3

>>> (remainder 13 4)
==> 1

>>> (remainder -13 4)
==> -1

>>> (modulo 13 4)
==> 1

>>> (modulo -13 4)
==> 3

>>> (min 3 1 4 1 5 9 2 6)
==> 1

>>> (max 3 1 4 1 5 9 2 6)
==> 9

;;; -------- Comparison primitives --------

>>> (= 1 1)
==> #t

>>> (= 1 1 1 1)
==> #t

>>> (= 1 2)
==> #f

>>> (< 1 2 3 4)
==> #t

>>> (< 1 3 2)
==> #f

>>> (> 4 3 2 1)
==> #t

>>> (<= 1 1 2 3)
==> #t

>>> (>= 3 3 2 1)
==> #t
