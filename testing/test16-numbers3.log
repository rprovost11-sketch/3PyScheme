;;; ============================================================
;;; test16-numbers3.log
;;; R7RS §6.2 numeric tower Phase 3:
;;;   rational arithmetic (Fraction)
;;;   #e on non-integer real -> rational literal
;;;   exact / inexact conversions for rationals
;;;   floor/ceiling/truncate/round on rationals -> exact integer
;;;   numerator/denominator on rationals
;;;   expt with exact negative exponent
;;;   sqrt of rational perfect square
;;;   comparisons with rationals
;;;   number->string / string->number for rationals
;;;   make-rectangular, make-polar, real-part, imag-part, magnitude, angle
;;; ============================================================

;;; -------- rational literal parsing --------

>>> 3/4
==> 3/4

>>> -3/4
==> -3/4

>>> 6/4
==> 3/2

;;; Fraction reduces at parse time.
>>> 4/2
==> 2

;;; -------- arithmetic on rationals --------

>>> (+ 1/2 1/3)
==> 5/6

>>> (- 1/2 1/3)
==> 1/6

>>> (* 2/3 3)
==> 2

>>> (* 1/2 1/3)
==> 1/6

>>> (/ 1/2 2)
==> 1/4

;;; (/ 1 3) now returns exact rational.
>>> (/ 1 3)
==> 1/3

;;; Unary reciprocal.
>>> (/ 2)
==> 1/2

>>> (/ 3/4)
==> 4/3

;;; Mixed exact/inexact -> inexact.
>>> (+ 1/2 0.5)
==> 1.0

;;; -------- #e prefix on non-integer real --------

>>> #e1.5
==> 3/2

>>> #e0.1
==> 3602879701896397/36028797018963968

>>> #e-0.5
==> -1/2

;;; -------- exact / inexact conversions --------

>>> (exact 1.5)
==> 3/2

>>> (exact 0.75)
==> 3/4

>>> (inexact 3/4)
==> 0.75

>>> (inexact 1/3)
==> 0.3333333333333333

;;; exact on an already-exact rational is a no-op.
>>> (exact 3/4)
==> 3/4

;;; -------- predicates --------

>>> (exact? 3/4)
==> #t

>>> (inexact? 3/4)
==> #f

>>> (rational? 3/4)
==> #t

;;; Finite reals are also rational in R7RS.
>>> (rational? 1.5)
==> #t

>>> (rational? +inf.0)
==> #f

>>> (number? 3/4)
==> #t

>>> (real? 3/4)
==> #t

>>> (integer? 3/4)
==> #f

;;; -------- comparisons --------

>>> (< 1/3 1/2)
==> #t

>>> (= 2/4 1/2)
==> #t

>>> (> 3/4 1/2)
==> #t

>>> (<= 1/3 1/3)
==> #t

>>> (= 1/2 0.5)
==> #t

;;; -------- numerator / denominator --------

>>> (numerator 3/4)
==> 3

>>> (denominator 3/4)
==> 4

>>> (numerator 2)
==> 2

>>> (denominator 2)
==> 1

;;; -------- floor / ceiling / truncate / round --------

;;; Results are exact integers for exact rational input.
>>> (floor 7/2)
==> 3

>>> (floor -7/2)
==> -4

>>> (ceiling 7/2)
==> 4

>>> (ceiling -7/2)
==> -3

>>> (truncate 7/2)
==> 3

>>> (truncate -7/2)
==> -3

;;; 7/2 = 3.5; banker's rounding -> 4 (even).
>>> (round 7/2)
==> 4

;;; 5/2 = 2.5; banker's rounding -> 2 (even).
>>> (round 5/2)
==> 2

;;; -------- abs --------

>>> (abs -3/4)
==> 3/4

>>> (abs 3/4)
==> 3/4

;;; -------- min / max --------

>>> (min 1/3 1/2)
==> 1/3

>>> (max 1/3 1/2)
==> 1/2

;;; Mixed: any real -> result is inexact.
>>> (min 1/3 0.4)
==> 0.3333333333333333

;;; -------- expt with exact arguments --------

;;; Positive integer exponent on integer -> integer.
>>> (expt 2 3)
==> 8

;;; Negative integer exponent -> rational.
>>> (expt 2 -2)
==> 1/4

>>> (expt 2 -1)
==> 1/2

;;; Rational base.
>>> (expt 1/2 3)
==> 1/8

>>> (expt 2/3 2)
==> 4/9

;;; -------- sqrt of rational perfect square --------

>>> (sqrt 4/9)
==> 2/3

>>> (sqrt 1/4)
==> 1/2

;;; Non-perfect-square -> inexact.
>>> (inexact? (sqrt 1/2))
==> #t

;;; -------- square --------

>>> (square 3/4)
==> 9/16

;;; -------- number->string / string->number --------

>>> (number->string 3/4)
==> "3/4"

>>> (number->string -1/3)
==> "-1/3"

>>> (string->number "3/4")
==> 3/4

>>> (string->number "-1/3")
==> -1/3

>>> (string->number "4/2")
==> 2

;;; #e on a rational string -> rational.
>>> (string->number "#e3/4")
==> 3/4

;;; -------- make-rectangular / make-polar --------

>>> (make-rectangular 3 4)
==> 3.0+4.0i

>>> (make-rectangular 0 1)
==> 0.0+1.0i

>>> (make-rectangular 1/2 1/3)
==> 0.5+0.3333333333333333i

>>> (real-part (make-polar 1 0))
==> 1.0

>>> (imag-part (make-polar 1 0))
==> 0.0

;;; -------- real-part / imag-part --------

>>> (real-part 3+4i)
==> 3.0

>>> (imag-part 3+4i)
==> 4.0

;;; For exact integers: exact 0 for imag-part.
>>> (real-part 5)
==> 5

>>> (imag-part 5)
==> 0

;;; For inexact reals: inexact 0.0 for imag-part.
>>> (imag-part 5.0)
==> 0.0

;;; For rational: exact 0 for imag-part.
>>> (real-part 3/4)
==> 3/4

>>> (imag-part 3/4)
==> 0

;;; -------- magnitude / angle --------

>>> (magnitude 3+4i)
==> 5.0

>>> (magnitude 5)
==> 5

>>> (magnitude -5)
==> 5

>>> (magnitude 3/4)
==> 3/4

>>> (angle 1)
==> 0.0

>>> (angle -1)
==> 3.141592653589793

>>> (angle 1+0i)
==> 0.0
