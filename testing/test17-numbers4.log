;;; ============================================================
;;; test17-numbers4.log
;;; R7RS §6.2 numeric tower Phase 4:
;;;   complex arithmetic (+, -, *, /)
;;;   sqrt of negative real -> complex
;;;   inexact? / exact? / finite? / infinite? / nan? on complex
;;;   = on complex
;;;   abs / square / expt on complex
;;;   transcendentals (exp, log, sin, cos) on complex
;;;   inexact / exact applied to complex
;;;
;;; Note: complex literals with exact components (e.g. 3+4i) are exact.
;;;   Arithmetic on exact complex produces exact results.
;;;   Transcendentals on complex always produce inexact results.
;;; ============================================================

;;; -------- exact complex arithmetic --------

>>> (+ 3+4i 1-2i)
==> 4+2i

;;; Complex terms cancel to exact integer zero.
>>> (+ 3+4i -3-4i)
==> 0

>>> (- 3+4i 1+2i)
==> 2+2i

>>> (- 0+1i 0+1i)
==> 0

>>> (* 3+4i 1+2i)
==> -5+10i

;;; Product with conjugate -> exact integer.
>>> (* 1+2i 1-2i)
==> 5

;;; Mixed exact complex * exact integer -> exact complex.
>>> (* 3+4i 2)
==> 6+8i

;;; Division: imaginary parts cancel -> exact integer.
;;; (4+0i)/(2+0i) = 4/2 = 2, but 4+0i and 2+0i parse as 4 and 2.
>>> (/ 4 2)
==> 2

>>> (/ 0+2i 0+1i)
==> 2

;;; Division with non-trivial result -> exact rational complex.
>>> (/ 1+2i 1+1i)
==> 3/2+1/2i

;;; -------- sqrt of negative real --------

>>> (sqrt -1)
==> 0.0+1.0i

>>> (sqrt -4)
==> 0.0+2.0i

>>> (sqrt -1/4)
==> 0.0+0.5i

;;; sqrt of complex.
>>> (sqrt 0+1i)
==> 0.7071067811865476+0.7071067811865475i

;;; -------- predicates on exact complex --------

>>> (inexact? 3+4i)
==> #f

>>> (exact? 3+4i)
==> #t

;;; -------- finite? / infinite? / nan? on complex --------

>>> (finite? 3+4i)
==> #t

>>> (finite? +inf.0+0.0i)
==> #f

>>> (infinite? +inf.0+0.0i)
==> #t

>>> (infinite? 3+4i)
==> #f

>>> (nan? +nan.0+0.0i)
==> #t

>>> (nan? 3+4i)
==> #f

;;; -------- = on complex --------

>>> (= 3+4i 3+4i)
==> #t

>>> (= 3+4i 3+5i)
==> #f

;;; Complex with zero imaginary part equals the real.
>>> (= 2+0i 2)
==> #t

;;; -------- abs on complex (magnitude) --------

>>> (abs 3+4i)
==> 5.0

>>> (abs 0+1i)
==> 1.0

;;; -------- square on complex --------

;;; square goes through the float path -> inexact result.
>>> (square 3+4i)
==> -7.0+24.0i

;;; i^2 = -1.
>>> (square 0+1i)
==> -1.0

;;; -------- expt on complex --------

;;; Integer exponent on integer base (2+0i parses as 2).
>>> (expt 2+0i 3)
==> 8

;;; i^2 = -1: expt goes through float path -> inexact.
>>> (expt 0+1i 2)
==> -1.0

;;; i^4 = 1.
>>> (expt 0+1i 4)
==> 1.0

;;; -------- transcendentals on complex --------

;;; e^0 = 1.
>>> (exp 0+0i)
==> 1.0

;;; Euler's formula: e^(i*1) = cos(1) + i*sin(1).
>>> (exp 0+1i)
==> 0.5403023058681398+0.8414709848078965i

;;; log(1+0i) = 0.
>>> (log 1+0i)
==> 0.0

;;; log(-1+0i) = i*pi.
>>> (log -1+0i)
==> 0.0+3.141592653589793i

;;; sin(0+0i) = 0.
>>> (sin 0+0i)
==> 0.0

;;; cos(0+0i) = 1.
>>> (cos 0+0i)
==> 1.0

;;; -------- inexact / exact applied to complex --------

;;; inexact converts exact complex to inexact complex.
>>> (inexact 3+4i)
==> 3.0+4.0i

;;; exact of exact complex is a no-op.
>>> (exact 3+4i)
==> 3+4i

;;; exact of inexact complex converts each component.
>>> (exact 3.0+4.0i)
==> 3+4i

;;; -------- number->string on computed complex --------

>>> (number->string (sqrt -1))
==> "0.0+1.0i"

;;; exact complex literal prints without .0
>>> (number->string (+ 3+4i 0))
==> "3+4i"
